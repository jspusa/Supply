{
  "name": "jspusa-supply",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm ci --ignore-scripts --no-audit --no-fund && npm run verify",
    "test": "node --test tests/*.test.mjs",
